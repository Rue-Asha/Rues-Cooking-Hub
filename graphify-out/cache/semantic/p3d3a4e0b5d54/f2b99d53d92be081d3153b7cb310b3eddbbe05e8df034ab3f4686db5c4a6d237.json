{"nodes": [{"id": "openspec_specs_harness_spec", "label": "harness Specification", "file_type": "document", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the harness capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_harness_spec_proof_commands", "label": "Proof commands (harness)", "file_type": "concept", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The repo SHALL provide `npm run proof` (svelte-check with `--fail-on-warnings`, build, vitest) and `npm run proof:full` (proof plus Playwright e2e). Both SHALL print the name of every passed test (vitest `--reporter=verbose`, Playwright `--reporter=list`) and exit non-zero on any failure. The e2e server SHALL listen on `$PORT` (default 4173) and use a fresh database at `.e2e/$PORT.db`, removed bef", "scenarios": ["Proof prints test names and passes", "Proof fails on a failing check", "Proof-full runs e2e on an isolated database"]}, {"id": "openspec_specs_harness_spec_e2e_projects_and_isolation", "label": "E2E projects and isolation (harness)", "file_type": "concept", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Playwright SHALL run two projects, `phone` (390\u00d7844, touch, mobile) and `desktop` (1280\u00d7800), against the built adapter-node server (`node build`, or `node $E2E_APP_DIR/build` when `E2E_APP_DIR` is set), with `PROTOCOL_HEADER=x-forwarded-proto`, `extraHTTPHeaders: { 'x-forwarded-proto': 'http' }`, `BODY_SIZE_LIMIT=16M` and `COOKING_HUB_TEST=1`. Tests SHALL run with `workers: 1`; every test that re", "scenarios": ["Each e2e test runs on phone and desktop", "App is hydrated before tests interact"]}, {"id": "openspec_specs_harness_spec_test_only_routes", "label": "Test-only routes (harness)", "file_type": "concept", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`POST /__test/reset`, `POST /__test/seed` and `POST /__test/clock` SHALL exist only for e2e and answer 404 unless `COOKING_HUB_TEST=1`. Reset SHALL delete every recipe, image, plan entry, shopping item and category memory and restore exactly the starter tags. Seed SHALL insert the recipes (with tags, sections, an optional generated image, explicit `createdAt`/`favouritedAt`), plan entries, shoppin", "scenarios": ["Test routes answer 404 without the test flag", "Reset leaves an empty archive with the starter tags", "Seed returns the ids of what it inserted", "Test clock sets today"]}, {"id": "openspec_specs_harness_spec_package_script", "label": "Package script (harness)", "file_type": "concept", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`npm run package` SHALL build the app and write `dist/rues-cooking-hub-<version>.tgz` plus `dist/rues-cooking-hub-<version>.tgz.sha256`. The tarball SHALL hold one top-level directory `rues-cooking-hub-<version>/` with `build/`, `migrations/`, the production `package.json`, the lockfile and production `node_modules` (including sharp's prebuilt linux-x64 binaries).", "scenarios": ["Package produces a verifiable tarball"]}, {"id": "openspec_specs_harness_spec_harness_declaration", "label": "Harness declaration (harness)", "file_type": "concept", "source_file": "openspec/specs/harness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`CLAUDE.md` SHALL contain `## Harness` declaring proof `npm run proof`, proof-full `npm run proof:full`, run `npm run dev` \u2192 http://localhost:5173, package, `ship: merge` and `release: tag`.", "scenarios": ["Harness declared with merge and tag policy"]}], "edges": [{"source": "openspec_specs_harness_spec", "target": "openspec_specs_harness_spec_proof_commands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec", "target": "openspec_specs_harness_spec_e2e_projects_and_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec", "target": "openspec_specs_harness_spec_test_only_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec", "target": "openspec_specs_harness_spec_package_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec", "target": "openspec_specs_harness_spec_harness_declaration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec", "target": "openspec_changes_archive_2026_10_20_build_cooking_hub_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/harness/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_harness_spec_proof_commands", "target": "package", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/harness/spec.md", "source