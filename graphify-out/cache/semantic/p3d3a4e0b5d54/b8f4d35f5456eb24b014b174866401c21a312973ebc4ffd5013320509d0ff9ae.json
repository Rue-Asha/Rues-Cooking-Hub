{"nodes": [{"id": "openspec_specs_design_system_spec", "label": "design-system Specification", "file_type": "document", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the design-system capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_design_system_spec_light_warm_tokens", "label": "Light warm tokens (design-system)", "file_type": "concept", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Every colour, radius, shadow, blur, spacing step, duration and easing SHALL come from the custom properties in `src/lib/styles/tokens.css` (mirrored in `src/lib/styles/tokens.ts` for tests); no raw colour SHALL appear in a component. The palette SHALL be light and warm: cream/sand ground, stone grey, olive and brick-red accents, one dark tile style (design.md \u2192 Visual brief). There SHALL be no dar", "scenarios": ["Text contrast meets 4.5:1", "Glass panel text stays legible over any photo", "Components use no raw colour", "Dark colour scheme preference changes nothing"]}, {"id": "openspec_specs_design_system_spec_self_hosted_fonts", "label": "Self-hosted fonts (design-system)", "file_type": "concept", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The app SHALL use one serif display face and one sans text face (chosen in the mockup unit), stored as woff2 under `static/fonts/` with their licence files, declared with `@font-face` in the app and preloaded in `app.html`. No page SHALL request a resource from another origin.", "scenarios": ["Pages load no external resources", "Display and text fonts load from the app"]}, {"id": "openspec_specs_design_system_spec_shared_components", "label": "Shared components (design-system)", "file_type": "concept", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`src/lib/ui/` SHALL provide GlassPanel, PillNav, ArrowButton (arrow in a circle, dark and light variants), RoundNav (prev/next pair), Card, Chip (outlined, active filled), Button (primary dark pill, secondary), Kicker, Counter (`01/07`, tabular numerals), Tile (light and dark) and ImagePlaceholder (the designed no-image state). Every button and nav link SHALL be at least 44\u00d744 px on phone.", "scenarios": ["Controls are at least 44px on phone", "Components match the visual brief"]}, {"id": "openspec_specs_design_system_spec_motion_module", "label": "Motion module (design-system)", "file_type": "concept", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`src/lib/motion.ts` SHALL export `reducedMotion()` and the shared motion primitives (design.md \u2192 Contracts). Movement, entrances and exits SHALL animate only `transform` and `opacity`. Three exceptions are allowed: (a) colour, background, border-colour and box-shadow transitions on interactive state changes (hover, focus, pressed, selected, checked); (b) the height-based `slide` that inserts or re", "scenarios": ["Reduced motion makes transitions instant", "Motion animates only transform and opacity"]}, {"id": "openspec_specs_design_system_spec_mockups_before_feature_ui", "label": "Mockups before feature UI (design-system)", "file_type": "concept", "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Static mockups of Home, Recipes, Recipe detail, Import (preview and fallback form), Plan and List SHALL exist at `/__mockups/<screen>` (404 unless `COOKING_HUB_TEST=1`), built from the shared components with fixture data and ~8 free-licence food photos in `static/mockups/` whose source URL, author and licence are listed in `static/mockups/CREDITS.txt`, and `npm run shots:mockups` SHALL write their", "scenarios": ["Mockup screenshots are produced for both viewports", "Every mockup photo is credited", "Mockup routes are hidden without the test flag", "Main screens share one alignment rule", "Rue approves the mockups", "Requested changes revise the mockups"]}], "edges": [{"source": "openspec_specs_design_system_spec", "target": "openspec_specs_design_system_spec_light_warm_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_design_system_spec", "target": "openspec_specs_design_system_spec_self_hosted_fonts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_design_system_spec", "target": "openspec_specs_design_system_spec_shared_components", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_design_system_spec", "target": "openspec_specs_design_system_spec_motion_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_design_system_spec", "target": "openspec_specs_design_system_spec_mockups_before_feature_ui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/design-system/spec.md", "source_location": null, "weight