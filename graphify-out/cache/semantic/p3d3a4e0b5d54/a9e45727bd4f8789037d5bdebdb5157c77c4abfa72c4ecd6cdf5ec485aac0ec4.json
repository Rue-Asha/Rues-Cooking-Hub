{"nodes": [{"id": "openspec_specs_shopping_list_spec", "label": "shopping-list Specification", "file_type": "document", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the shopping-list capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_shopping_list_spec_manual_items", "label": "Manual items (shopping-list)", "file_type": "concept", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`/list` SHALL be the one shopping list. A typed line SHALL be parsed like an ingredient line (`2 l milk` \u2192 name `milk`, amount 2 l) and added as a manual item; empty input SHALL add nothing; a line whose name key equals an open manual item's (ignoring case, singular/plural folded) SHALL merge its amount into that item. An item's name and amount (free text such as `200 g` or `1 cup + 200 g`) SHALL ", "scenarios": ["Manual item is parsed", "Empty input adds nothing", "Same manual name merges amounts", "Add a manual item", "Edit an item's name and amount", "Delete an item"]}, {"id": "openspec_specs_shopping_list_spec_add_from_plan", "label": "Add from plan (shopping-list)", "file_type": "concept", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\"Add from plan\" SHALL ask for a date range (default: the current week Monday\u2013Sunday) and add the ingredients of every recipe entry in the range, each line's quantity scaled by entry servings / recipe servings. Free-text entries SHALL contribute nothing. Lines SHALL merge by name key (ignoring case, singular and plural folded: `1 onion` + `2 onions` \u2192 3 onions, shown with the longest name seen); eq", "scenarios": ["Ingredients scale by entry servings", "Equal names and units merge", "Metric family amounts sum", "Mixed units stay on one line", "Singular and plural names fold to one line", "Line without quantity appears once without amount", "Add from plan adds scaled, merged items", "Free-text entries contribute nothing", "Regenerating replaces open plan items", "Manual and checked items survive regenerating", "Checked plan item is not re-added", "Empty range changes nothing", "Plan amounts merge into a manual item with the same name", "Regenerating recalculates the plan part of a manual item", "Add from plan for the shown week", "Merged item shows its manual and plan parts", "Empty range reports nothing planned"]}, {"id": "openspec_specs_shopping_list_spec_categories", "label": "Categories (shopping-list)", "file_type": "concept", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Items SHALL be grouped under the fixed categories Produce, Dairy & Eggs, Meat & Fish, Bakery, Pantry, Frozen, Drinks, Household, Other, in that order; empty categories SHALL be hidden. A new item SHALL go to the category last chosen for its name (ignoring case), else Other. Moving an item to a category SHALL remember that choice for its name.", "scenarios": ["New item uses the remembered category", "Unknown item goes to Other", "Category memory ignores case", "List grouped by category with empty ones hidden", "Moving an item to a category remembers it"]}, {"id": "openspec_specs_shopping_list_spec_check_off", "label": "Check off (shopping-list)", "file_type": "concept", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Checking an item SHALL fill its checkbox, strike its text and move it into a \"Checked\" section at the bottom of the list (with a slide animation); unchecking SHALL return it to its category. \"Clear checked\" SHALL delete every checked item and SHALL be disabled when nothing is checked. Under reduced motion the item SHALL move without sliding.", "scenarios": ["Clear checked removes all checked items", "Check off moves the item to Checked", "Uncheck restores the item", "Clear checked is disabled with nothing checked", "Reduced motion checks off without sliding", "Check-off animation feels satisfying"]}, {"id": "openspec_specs_shopping_list_spec_recipe_to_list_journey", "label": "Recipe to list journey (shopping-list)", "file_type": "concept", "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The archive, plan and list SHALL work together so that an imported recipe, edited, tagged and planned with 4 servings, ends up on the list scaled, merged and grouped by category.", "scenarios": ["Imported recipe reaches the list scaled and grouped"]}], "edges": [{"source": "openspec_specs_shopping_list_spec", "target": "openspec_specs_shopping_list_spec_manual_items", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec", "target": "openspec_specs_shopping_list_spec_add_from_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec", "target": "openspec_specs_shopping_list_spec_categories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec", "target": "openspec_specs_shopping_list_spec_check_off", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec", "target": "openspec_specs_shopping_list_spec_recipe_to_list_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec", "target": "openspec_changes_archive_2026_10_20_build_cooking_hub_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec_manual_items", "target": "src_lib_server_shopping_addmanual", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec_manual_items", "target": "src_lib_shopping_aggregate_parseamounts", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec_manual_items", "target": "src_lib_list_item", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec_add_from_plan", "target": "src_lib_server_shopping_addfromplan", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/specs/shopping-list/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shopping_list_spec_add_from_plan", "target": "src_lib_shopping_aggregate_aggregate", "rela