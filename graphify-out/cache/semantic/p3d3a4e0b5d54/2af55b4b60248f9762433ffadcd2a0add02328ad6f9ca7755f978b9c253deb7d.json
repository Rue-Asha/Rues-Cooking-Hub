{"nodes": [{"id": "openspec_specs_runtime_spec", "label": "runtime Specification", "file_type": "document", "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the runtime capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_runtime_spec_database_and_migrations", "label": "Database and migrations (runtime)", "file_type": "concept", "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The server SHALL open the SQLite database at `DATABASE_PATH` (default `./data/rues-cooking-hub.db`) with `node:sqlite`, create its directory if missing, enable WAL and foreign keys, and apply the numbered `migrations/NNNN_*.sql` files of its package in order on start, each in its own transaction, recording each applied name in `schema_migrations`. A failing migration SHALL be rolled back and stop ", "scenarios": ["Fresh database gets the schema and starter tags", "Only new migrations run on an existing database", "Failing migration stops the server", "Missing database directory is created"]}, {"id": "openspec_specs_runtime_spec_health_check", "label": "Health check (runtime)", "file_type": "concept", "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`GET /healthz` SHALL return 200 with body `ok` when the database answers `SELECT 1`, and 503 otherwise.", "scenarios": ["Healthy server answers 200", "Unreadable database answers 503"]}, {"id": "openspec_specs_runtime_spec_server_runtime_configuration", "label": "Server runtime configuration (runtime)", "file_type": "concept", "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The production server SHALL read `PORT`, `HOST`, `DATABASE_PATH`, `PROTOCOL_HEADER` and `BODY_SIZE_LIMIT`, find its `migrations/` relative to its own package (not the working directory), and `package.json` SHALL declare `engines.node >=22.18`.", "scenarios": ["Server starts from any working directory", "Form posts pass the CSRF check behind the proxy header"]}], "edges": [{"source": "openspec_specs_runtime_spec", "target": "openspec_specs_runtime_spec_database_and_migrations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_runtime_spec", "target": "openspec_specs_runtime_spec_health_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_runtime_spec", "target": "openspec_specs_runtime_spec_server_runtime_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_runtime_spec", "target": "openspec_changes_archive_2026_10_20_build_cooking_hub_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_runtime_spec_database_and_migrations", "target": "src_lib_server_db_migrate", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/runtime/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_runtime_spec_database_and_migrations", "target": "src_lib_server_db_getdb", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/