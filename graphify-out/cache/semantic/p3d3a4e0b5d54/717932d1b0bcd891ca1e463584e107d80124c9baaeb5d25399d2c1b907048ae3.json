{"nodes": [{"id": "openspec_specs_ingredients_spec", "label": "ingredients Specification", "file_type": "document", "source_file": "openspec/specs/ingredients/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the ingredients capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_ingredients_spec_ingredient_line_parser", "label": "Ingredient line parser (ingredients)", "file_type": "concept", "source_file": "openspec/specs/ingredients/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`parseIngredient(text)` SHALL turn each typed or imported line into quantity \u00b7 unit \u00b7 name, plus an optional trailing note, and SHALL always keep the original text. Quantities SHALL handle integers, decimals with a point or a comma (`1,5` \u2192 1.5), fractions (`1/2`, `1 1/2`, `\u00bd`, `1\u00bd`) and ranges (`2-3`, `2\u20133`: the upper bound is the quantity, the text keeps the range). Units SHALL be recognised fro", "scenarios": ["Integer quantity with unit", "Decimal quantity", "Comma decimal", "Mixed and unicode fractions", "Range uses the upper bound", "Attached unit", "Trailing note is split off", "Count without unit", "Line without quantity", "Unparseable line becomes the name"]}, {"id": "openspec_specs_ingredients_spec_live_parse_preview", "label": "Live parse preview (ingredients)", "file_type": "concept", "source_file": "openspec/specs/ingredients/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The recipe form SHALL show, under each ingredient line, its parse (quantity \u00b7 unit \u00b7 name) and update it while typing.", "scenarios": ["Parse preview updates while typing"]}], "edges": [{"source": "openspec_specs_ingredients_spec", "target": "openspec_specs_ingredients_spec_ingredient_li