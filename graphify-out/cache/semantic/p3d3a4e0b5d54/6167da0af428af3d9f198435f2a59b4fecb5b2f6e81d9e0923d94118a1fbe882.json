{"nodes": [{"id": "openspec_specs_navigation_spec", "label": "navigation Specification", "file_type": "document", "source_file": "openspec/specs/navigation/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the navigation capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_navigation_spec_area_navigation", "label": "Area navigation (navigation)", "file_type": "concept", "source_file": "openspec/specs/navigation/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The app SHALL offer four areas, Home (`/`), Recipes (`/recipes`), Plan (`/plan`) and List (`/list`), in a floating glass pill nav at the top on viewports at least 1024 px wide and in a floating pill tab bar at the bottom below that. The current area SHALL be marked with `aria-current=\"page\"`, also on pages below it (`/recipes/12` marks Recipes). After the page is scrolled more than 48 px the nav S", "scenarios": ["Desktop shows the top pill nav", "Phone shows the bottom tab bar", "Active area is marked", "Nav marks the open area", "Tablet and phone landscape use one layout without overlap", "Nav shrinks on scroll", "Compact tab bar shows icons only", "Reduced motion shrinks the tab bar instantly", "Nav shrink looks calm"]}, {"id": "openspec_specs_navigation_spec_page_transitions", "label": "Page transitions (navigation)", "file_type": "concept", "source_file": "openspec/specs/navigation/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Navigation between areas SHALL animate through `document.startViewTransition` when the browser supports it and reduced motion is not requested; otherwise it SHALL navigate instantly without error.", "scenarios": ["Area change uses a view transition", "Browser without View Transitions navigates ins