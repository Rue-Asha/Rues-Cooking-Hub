{"nodes": [{"id": "openspec_specs_recipe_detail_spec", "label": "recipe-detail Specification", "file_type": "document", "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the recipe-detail capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_recipe_detail_spec_recipe_page", "label": "Recipe page (recipe-detail)", "file_type": "concept", "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`/recipes/<id>` SHALL show a full-bleed hero image (or the placeholder hero) with a glass info panel holding title, times (prep, cook, total; none shown when empty), servings, tags, the favourite toggle and a \"Source\" link (only when there is a source URL), then the ingredients and steps by section (section titles as headings, each ingredient line as its original text) and the rendered notes, with", "scenarios": ["Recipe page shows hero, info panel, sections and notes", "Recipe page without image shows the placeholder hero", "Recipe page without source URL shows no source link", "Recipe without times shows no times on its page", "Unknown recipe answers 404", "Favourite toggles on the recipe page"]}, {"id": "openspec_specs_recipe_detail_spec_hero_motion", "label": "Hero motion (recipe-detail)", "file_type": "concept", "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "While the page scrolls, the hero image SHALL move slower than the content and zoom slightly (parallax). Card \u2192 recipe page and back SHALL use a shared-element view transition of the hero image (`view-transition-name: recipe-hero-<id>` on both the card image and the hero). Under reduced motion there SHALL be no parallax and no shared element.", "scenarios": ["Hero moves on scroll", "Reduced motion keeps the hero still", "Card and recipe page share the hero image", "Reduced motion skips the shared element", "Hero parallax and shared element look smooth"]}, {"id": "openspec_specs_recipe_detail_spec_add_to_plan_from_a_recipe", "label": "Add to plan from a recipe (recipe-detail)", "file_type": "concept", "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "\"Add to plan\" on the recipe page SHALL open a dialog with day (default today), slot (default Dinner) and servings (default the recipe's servings, at least 1); confirming SHALL add a recipe entry at the end of that slot and offer a link to that week in the plan.", "scenarios": ["Add to plan from the recipe", "Servings below 1 are rejected when adding from the recipe"]}], "edges": [{"source": "openspec_specs_recipe_detail_spec", "target": "openspec_specs_recipe_detail_spec_recipe_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_recipe_detail_spec", "target": "openspec_specs_recipe_detail_spec_hero_motion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_recipe_detail_spec", "target": "openspec_specs_recipe_detail_spec_add_to_plan_from_a_recipe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/recipe-detail/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_recipe_detail_spec", "target": "openspec_changes_archive_2026_10_20_build_cooking_hub_proposal", "relation": "references", "confidence": "EXTRACTED", "con