{"nodes": [{"id": "openspec_specs_tags_spec", "label": "tags Specification", "file_type": "document", "source_file": "openspec/specs/tags/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Main OpenSpec spec for the tags capability (created by archiving build-cooking-hub)"}, {"id": "openspec_specs_tags_spec_free_tags", "label": "Free tags (tags)", "file_type": "concept", "source_file": "openspec/specs/tags/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Tags SHALL be free names, seeded with Breakfast, Main Course, Side, Dessert, Snack, Soup, Salad and Baking. Tags SHALL be created while editing a recipe by typing a name; a name equal to an existing tag ignoring case (including non-ASCII letters) SHALL reuse that tag.", "scenarios": ["New tag created while editing a recipe", "Duplicate tag name reuses the existing tag"]}, {"id": "openspec_specs_tags_spec_tag_manager", "label": "Tag manager (tags)", "file_type": "concept", "source_file": "openspec/specs/tags/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "`/recipes/tags` SHALL list every tag with the number of recipes using it and allow rename and delete. Renaming to a name another tag already has (ignoring case) SHALL merge the two: every recipe of the renamed tag gets the existing tag, the renamed tag is deleted, and the existing tag keeps its name. Deleting a tag in use SHALL ask \"Delete tag \u201c<name>\u201d? It's used by <n> recipes.\" and remove it fro", "scenarios": ["Rename a tag", "Renaming onto an existing name merges the tags", "Rename onto an existing tag merges them in the manager", "Deleting a tag in use names the count", "Deleted tag is removed from its recipes"]}], "edges": [{"source": "openspec_specs_tags_spec", "target": "openspec_specs_tags_spec_free_tags", "rel