{
	"name": "rues-cooking-hub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test:unit": "vitest run --reporter=verbose",
		"test:e2e": "playwright test --reporter=list",
		"proof": "npm run check && npm run build && npm run test:unit",
		"proof:full": "npm run proof && npm run test:e2e",
		"package": "npm run build && node scripts/package.mjs",
		"shots:mockups": "npm run build && playwright test e2e/mockups.test.ts --reporter=list"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.5",
		"markdown-it": "^15.0.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"sharp": "^0.35.5"
	}
}
